# Скопируйте этот файл в .env и при необходимости измените значения.
# Файл .env нельзя коммитить: в нём ключи. Ненужную строку лучше закомментировать, чем оставлять пустой.
# После изменения .env перезапустите сервер.

# ───────────── ИИ-наставник ─────────────
# Провайдер ответов: rule (правила, ключ не нужен) или openai (модель OpenAI; при любой ошибке наставник отвечает по правилам).
TUTOR_PROVIDER=rule
# Ключ OpenAI нужен только при TUTOR_PROVIDER=openai и пакете openai (pip install openai). Хранить только здесь или в секретах платформы.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Сколько запросов к модели OpenAI в час допускается с одной сессии (cookie lab_sid). Значение по умолчанию 30, 0 отключает лимит.
# Одинаковые вопросы с тем же контекстом берутся из кэша на час и лимит не тратят. Наставник по правилам (rule) не ограничивается.
# Счётчик хранится в памяти процесса: при нескольких экземплярах сервера лимит считается отдельно на каждом.
# TUTOR_RATE_LIMIT_PER_HOUR=30

# ───────────── База данных ─────────────
# Локальная работа и тесты: файл SQLite.
DB_PATH=data/lab.db
# Адрес базы данных. Не задан: используется SQLite из DB_PATH. Для PostgreSQL (например, Cloud SQL) укажите адрес вида
# postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/ИМЯ_БАЗЫ. Пароль в адресе хранить только в секретах, а не в файле, который коммитится.
# DATABASE_URL=
# Максимум одновременных соединений с PostgreSQL в одном экземпляре (по умолчанию 10; для SQLite не используется).
# Держите его меньше лимита соединений самой базы, поделённого на число экземпляров сервера.
# DB_POOL_MAX_SIZE=10

# ───────────── Песочница практикума ─────────────
# Сколько запусков кода студентов идёт одновременно (по умолчанию 2). Запрос ждёт свободного места до 3 секунд, затем получает
# ответ 503 «Сервер занят, повторите» (попытка студента при этом не засчитывается). Значение выбирайте по числу ядер: примерно ядра минус один.
# SANDBOX_MAX_CONCURRENT=2

# ───────────── Сервер и безопасность ─────────────
# Порт сервера (по умолчанию 8000).
# PORT=8000
# Интеграция с сайтом, где есть авторизация: имя HTTP-заголовка, в котором сайт (его сервер или прокси) передаёт ID пользователя,
# например X-User-Id. ID записывается в колонку subject журнала, попыток и экспериментов, а лимит наставника считается на пользователя.
# Доверяйте заголовку только если лаборатория доступна лишь через ваш сервер/прокси, который сам его выставляет и затирает чужой.
# Не задан: пользователи анонимны (cookie lab_sid), subject пустой.
# SUBJECT_HEADER=X-User-Id
# true: cookie сессии получает флаг Secure и отправляется только по HTTPS. Включайте на сервере с HTTPS, а при локальной работе по http оставьте false.
# COOKIE_SECURE=false

# ───────────── Модели лица ─────────────
# Скачивать нейросетевые модели лица при запуске сервера (true | false). Лицензия ArcFace: только исследования и обучение.
AUTO_DOWNLOAD_MODELS=true
